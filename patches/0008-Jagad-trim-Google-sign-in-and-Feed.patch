From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jagad <jagad@localhost>
Date: Sun, 1 Nov 2026 13:57:46 +0000
Subject: [PATCH] Jagad: hide Google sign-in and the Discover feed by default

A fork has no Google API keys, so sign-in, sync and the Discover feed
cannot work. Default them off instead of showing broken UI:
- signin.allowed defaults to false on Android (as BrowserSignin=0 policy);
- ntp_snippets.enable defaults to false (as NTPContentSuggestionsEnabled).

Lens needs no change: upstream hides it without the Lens app / Google DSE.

Note: Android instrumentation tests that sign in must set signin.allowed.
---
 components/feed/core/shared_prefs/pref_names.cc             | 4 +++-
 .../internal/identity_manager/primary_account_manager.cc    | 6 ++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/components/feed/core/shared_prefs/pref_names.cc b/components/feed/core/shared_prefs/pref_names.cc
index 50f880e..d111d9d 100644
--- a/components/feed/core/shared_prefs/pref_names.cc
+++ b/components/feed/core/shared_prefs/pref_names.cc
@@ -24,7 +24,9 @@ const char kArticlesListVisible[] = "ntp_snippets.list_visible";
 const char kEnableSnippetsByDse[] = "ntp_snippets_by_dse.enable";
 
 void RegisterFeedSharedProfilePrefs(PrefRegistrySimple* registry) {
-  registry->RegisterBooleanPref(kEnableSnippets, true);
+  // Jagad: no Google Discover feed on the New Tab Page (it needs Google
+  // services). Same effect as the NTPContentSuggestionsEnabled=false policy.
+  registry->RegisterBooleanPref(kEnableSnippets, false);
   registry->RegisterBooleanPref(kArticlesListVisible, true);
   registry->RegisterBooleanPref(kEnableSnippetsByDse, true);
 }
diff --git a/components/signin/internal/identity_manager/primary_account_manager.cc b/components/signin/internal/identity_manager/primary_account_manager.cc
index cb7399b..9575cb5 100644
--- a/components/signin/internal/identity_manager/primary_account_manager.cc
+++ b/components/signin/internal/identity_manager/primary_account_manager.cc
@@ -391,7 +391,13 @@ void PrimaryAccountManager::RegisterProfilePrefs(PrefRegistrySimple* registry) {
       prefs::kGoogleServicesSyncingUsernameMigratedToSignedIn, std::string());
   registry->RegisterIntegerPref(prefs::kGoogleServicesSyncingUserMigrationType,
                                 /*SyncToSigninMigrationType::kUnknown=*/0);
+#if BUILDFLAG(IS_ANDROID)
+  // Jagad: Google sign-in and sync need Google API keys that a fork does not
+  // have, so hide sign-in UI and promos by default.
+  registry->RegisterBooleanPref(prefs::kSigninAllowed, false);
+#else
   registry->RegisterBooleanPref(prefs::kSigninAllowed, true);
+#endif
   registry->RegisterBooleanPref(prefs::kSignedInWithCredentialProvider, false);
   registry->RegisterBooleanPref(prefs::kExplicitBrowserSignin, false);
   registry->RegisterBooleanPref(
