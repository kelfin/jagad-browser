From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jagad <jagad@localhost>
Date: Sun, 1 Nov 2026 13:51:13 +0000
Subject: [PATCH] Jagad: built-in adblock on all sites

Adds subresource_filter::kJagadAdblock (enabled by default):
- a new activation preset, jagad_adblock_on_all_sites (ALL_SITES, enabled,
  priority 100, below the phishing and Better Ads presets);
- RegisterSubresourceFilterComponent() indexes the EasyList/EasyPrivacy
  ruleset bundled as IDR_JAGAD_ADBLOCK_RULESET instead of downloading
  Google's ruleset component. The version string comes from
  IDR_JAGAD_ADBLOCK_RULESET_VERSION so a refreshed list is re-indexed.

The ruleset files are generated before the build by
jagad-browser/tools/build_ruleset.py into chrome/browser/resources/jagad/.
Per-site exceptions use the existing Intrusive ads site setting.

Tests: components_unittests --gtest_filter='SubresourceFilterFeaturesTest.*'
---
 chrome/browser/browser_resources.grd          |  5 +++
 .../subresource_filter_component_installer.cc | 26 +++++++++++
 .../browser/subresource_filter_features.cc    | 18 +++++++-
 .../browser/subresource_filter_features.h     |  7 +++
 .../subresource_filter_features_unittest.cc   | 45 ++++++++++++++++++-
 5 files changed, 99 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/browser_resources.grd b/chrome/browser/browser_resources.grd
index e8b4901..0606f4b 100644
--- a/chrome/browser/browser_resources.grd
+++ b/chrome/browser/browser_resources.grd
@@ -174,6 +174,11 @@
         <include name="IDR_DEV_UI_LOADER_ERROR_HTML" file="resources/dev_ui/dev_ui_loader_error.html" type="BINDATA" />
       </if>
 
+      <!-- Jagad built-in adblock ruleset. Generated before the build by
+           jagad-browser/tools/build_ruleset.py (not checked in). -->
+      <include name="IDR_JAGAD_ADBLOCK_RULESET" file="resources/jagad/adblock_ruleset.dat" type="BINDATA" compress="gzip" />
+      <include name="IDR_JAGAD_ADBLOCK_RULESET_VERSION" file="resources/jagad/adblock_ruleset_version.txt" type="BINDATA" />
+
       <if expr="enable_hangout_services_extension">
         <!-- Hangout Services extension, included in Google Chrome builds only. -->
         <include name="IDR_HANGOUT_SERVICES_MANIFEST_V2" file="resources\hangout_services\manifest_v2.json" type="BINDATA" />
diff --git a/chrome/browser/component_updater/subresource_filter_component_installer.cc b/chrome/browser/component_updater/subresource_filter_component_installer.cc
index e82a029..5a063b0 100644
--- a/chrome/browser/component_updater/subresource_filter_component_installer.cc
+++ b/chrome/browser/component_updater/subresource_filter_component_installer.cc
@@ -20,12 +20,15 @@
 #include "base/path_service.h"
 #include "base/values.h"
 #include "base/version.h"
+#include "base/strings/string_util.h"
 #include "chrome/browser/browser_process.h"
+#include "chrome/grit/browser_resources.h"
 #include "components/component_updater/component_updater_paths.h"
 #include "components/subresource_filter/content/browser/ruleset_service.h"
 #include "components/subresource_filter/core/browser/subresource_filter_constants.h"
 #include "components/subresource_filter/core/browser/subresource_filter_features.h"
 #include "components/subresource_filter/core/common/constants.h"
+#include "ui/base/resource/resource_bundle.h"
 
 namespace component_updater {
 
@@ -160,6 +163,29 @@ void RegisterSubresourceFilterComponent(ComponentUpdateService* cus) {
     return;
   }
 
+  // Jagad: use the EasyList/EasyPrivacy ruleset bundled in resources.pak
+  // (generated by jagad-browser/tools/build_ruleset.py) instead of
+  // downloading Google's ruleset component.
+  if (base::FeatureList::IsEnabled(subresource_filter::kJagadAdblock)) {
+    subresource_filter::RulesetService* ruleset_service =
+        g_browser_process->subresource_filter_ruleset_service();
+    if (!ruleset_service) {
+      return;
+    }
+    std::string version(
+        ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+            IDR_JAGAD_ADBLOCK_RULESET_VERSION));
+    base::TrimWhitespaceASCII(version, base::TRIM_ALL, &version);
+    if (version.empty()) {
+      return;
+    }
+    subresource_filter::UnindexedRulesetInfo ruleset_info;
+    ruleset_info.content_version = "jagad-" + version;
+    ruleset_info.resource_id = IDR_JAGAD_ADBLOCK_RULESET;
+    ruleset_service->IndexAndStoreAndPublishRulesetIfNeeded(ruleset_info);
+    return;
+  }
+
   auto installer = base::MakeRefCounted<ComponentInstaller>(
       std::make_unique<SubresourceFilterComponentInstallerPolicy>());
   installer->Register(cus, base::OnceClosure());
diff --git a/components/subresource_filter/core/browser/subresource_filter_features.cc b/components/subresource_filter/core/browser/subresource_filter_features.cc
index 5a27b46..0d21c89 100644
--- a/components/subresource_filter/core/browser/subresource_filter_features.cc
+++ b/components/subresource_filter/core/browser/subresource_filter_features.cc
@@ -132,7 +132,10 @@ std::vector<Configuration> FillEnabledPresetConfigurations(
       {kPresetPerformanceTestingDryRunOnAllSites, ad_tagging_enabled,
        &Configuration::MakePresetForPerformanceTestingDryRunOnAllSites},
       {kPresetLiveRunForBetterAds, true,
-       &Configuration::MakePresetForLiveRunForBetterAds}};
+       &Configuration::MakePresetForLiveRunForBetterAds},
+      {kPresetJagadAdblockOnAllSites,
+       base::FeatureList::IsEnabled(kJagadAdblock),
+       &Configuration::MakePresetForJagadAdblockOnAllSites}};
 
   CommaSeparatedStrings enabled_presets(
       TakeVariationParamOrReturnEmpty(params, kEnablePresetsParameterName));
@@ -246,6 +249,8 @@ BASE_FEATURE(kSafeBrowsingSubresourceFilter,
 
 BASE_FEATURE(kFilterAdsOnAbusiveSites, base::FEATURE_ENABLED_BY_DEFAULT);
 
+BASE_FEATURE(kJagadAdblock, base::FEATURE_ENABLED_BY_DEFAULT);
+
 BASE_FEATURE(kAdsInterventionsEnforced, base::FEATURE_DISABLED_BY_DEFAULT);
 
 const base::FeatureParam<base::TimeDelta> kAdsInterventionDuration = {
@@ -279,6 +284,7 @@ const char kDisablePresetsParameterName[] = "disable_presets";
 const char kPresetLiveRunOnPhishingSites[] = "liverun_on_phishing_sites";
 const char kPresetPerformanceTestingDryRunOnAllSites[] =
     "performance_testing_dryrun_on_all_sites";
+const char kPresetJagadAdblockOnAllSites[] = "jagad_adblock_on_all_sites";
 const char kPresetLiveRunForBetterAds[] =
     "liverun_on_better_ads_violating_sites";
 
@@ -311,6 +317,16 @@ Configuration Configuration::MakePresetForLiveRunForBetterAds() {
   return config;
 }
 
+// static
+Configuration Configuration::MakePresetForJagadAdblockOnAllSites() {
+  Configuration config(mojom::ActivationLevel::kEnabled,
+                       ActivationScope::ALL_SITES);
+  // Lower than the phishing (1000) and Better Ads (800) presets so those keep
+  // their behavior where they match; this one covers every other page.
+  config.activation_conditions.priority = 100;
+  return config;
+}
+
 Configuration::Configuration() = default;
 Configuration::Configuration(mojom::ActivationLevel activation_level,
                              ActivationScope activation_scope,
diff --git a/components/subresource_filter/core/browser/subresource_filter_features.h b/components/subresource_filter/core/browser/subresource_filter_features.h
index 159f188..2176f7e 100644
--- a/components/subresource_filter/core/browser/subresource_filter_features.h
+++ b/components/subresource_filter/core/browser/subresource_filter_features.h
@@ -125,6 +125,8 @@ struct Configuration {
   static Configuration MakePresetForLiveRunOnPhishingSites();
   static Configuration MakePresetForPerformanceTestingDryRunOnAllSites();
   static Configuration MakePresetForLiveRunForBetterAds();
+  // Jagad: block ads on every site using Jagad's bundled ruleset.
+  static Configuration MakePresetForJagadAdblockOnAllSites();
 
   ActivationConditions activation_conditions;
   ActivationOptions activation_options;
@@ -188,6 +190,10 @@ BASE_DECLARE_FEATURE(kSafeBrowsingSubresourceFilter);
 // Enables the blocking of ads on sites that are abusive.
 BASE_DECLARE_FEATURE(kFilterAdsOnAbusiveSites);
 
+// Jagad: built-in ad blocking on all sites with a bundled EasyList/EasyPrivacy
+// ruleset (instead of Google's downloaded "Better Ads" ruleset).
+BASE_DECLARE_FEATURE(kJagadAdblock);
+
 // Enables the blocking of ads on sites that have ads violations.
 BASE_DECLARE_FEATURE(kAdsInterventionsEnforced);
 
@@ -230,6 +236,7 @@ extern const char kDisablePresetsParameterName[];
 extern const char kPresetLiveRunOnPhishingSites[];
 extern const char kPresetPerformanceTestingDryRunOnAllSites[];
 extern const char kPresetLiveRunForBetterAds[];
+extern const char kPresetJagadAdblockOnAllSites[];
 
 }  // namespace subresource_filter
 
diff --git a/components/subresource_filter/core/browser/subresource_filter_features_unittest.cc b/components/subresource_filter/core/browser/subresource_filter_features_unittest.cc
index f44e7d6..04d6dcb 100644
--- a/components/subresource_filter/core/browser/subresource_filter_features_unittest.cc
+++ b/components/subresource_filter/core/browser/subresource_filter_features_unittest.cc
@@ -118,7 +118,11 @@ void ExpectParamsGeneratePreset(
 
 class SubresourceFilterFeaturesTest : public ::testing::Test {
  public:
-  SubresourceFilterFeaturesTest() = default;
+  SubresourceFilterFeaturesTest() {
+    // Upstream expectations assume no Jagad preset; JagadAdblock* tests below
+    // turn it back on explicitly.
+    jagad_feature_list_.InitAndDisableFeature(kJagadAdblock);
+  }
 
   SubresourceFilterFeaturesTest(const SubresourceFilterFeaturesTest&) = delete;
   SubresourceFilterFeaturesTest& operator=(
@@ -131,8 +135,47 @@ class SubresourceFilterFeaturesTest : public ::testing::Test {
     // cached value from a previous in-process test run.
     testing::GetAndSetActivateConfigurations(nullptr);
   }
+
+ private:
+  base::test::ScopedFeatureList jagad_feature_list_;
 };
 
+TEST_F(SubresourceFilterFeaturesTest, PresetForJagadAdblockOnAllSites) {
+  const Configuration config =
+      Configuration::MakePresetForJagadAdblockOnAllSites();
+  EXPECT_EQ(ActivationScope::ALL_SITES,
+            config.activation_conditions.activation_scope);
+  EXPECT_EQ(ActivationList::NONE, config.activation_conditions.activation_list);
+  EXPECT_EQ(100, config.activation_conditions.priority);
+  EXPECT_EQ(mojom::ActivationLevel::kEnabled,
+            config.activation_options.activation_level);
+}
+
+TEST_F(SubresourceFilterFeaturesTest, JagadAdblockEnabledAddsAllSitesPreset) {
+  base::test::ScopedFeatureList features;
+  features.InitWithFeatures({kJagadAdblock, kSafeBrowsingSubresourceFilter},
+                            {});
+  testing::GetAndSetActivateConfigurations(nullptr);
+  const auto& configs =
+      GetEnabledConfigurations()->configs_by_decreasing_priority();
+  EXPECT_TRUE(std::ranges::any_of(configs, [](const Configuration& c) {
+    return c == Configuration::MakePresetForJagadAdblockOnAllSites();
+  }));
+  testing::GetAndSetActivateConfigurations(nullptr);
+}
+
+TEST_F(SubresourceFilterFeaturesTest, JagadAdblockDisabledHasNoAllSitesPreset) {
+  base::test::ScopedFeatureList features;
+  features.InitWithFeatures({kSafeBrowsingSubresourceFilter}, {kJagadAdblock});
+  testing::GetAndSetActivateConfigurations(nullptr);
+  const auto& configs =
+      GetEnabledConfigurations()->configs_by_decreasing_priority();
+  EXPECT_FALSE(std::ranges::any_of(configs, [](const Configuration& c) {
+    return c == Configuration::MakePresetForJagadAdblockOnAllSites();
+  }));
+  testing::GetAndSetActivateConfigurations(nullptr);
+}
+
 TEST_F(SubresourceFilterFeaturesTest, ActivationLevel) {
   const struct {
     bool feature_enabled;
