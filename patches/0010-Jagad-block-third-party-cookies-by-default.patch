From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jagad <jagad@localhost>
Date: Sun, 1 Nov 2026 14:01:52 +0000
Subject: [PATCH] Jagad: block third-party cookies by default

Sets the default of profile.cookie_controls_mode to kBlockThirdParty on
Android in chrome::RegisterProfilePrefs (Chrome-only, so component unit
tests keep upstream defaults). Users can re-allow per site or globally.

HTTPS-Upgrades and automatic secure DNS are already on by default
upstream, so they need no patch.

Verify: Settings > Site settings > Third-party cookies shows 'Block'.
---
 chrome/browser/prefs/browser_prefs.cc | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/chrome/browser/prefs/browser_prefs.cc b/chrome/browser/prefs/browser_prefs.cc
index 35b0268..6254e34 100644
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -15,6 +15,7 @@
 #include "base/json/values_util.h"
 #include "base/time/time.h"
 #include "base/trace_event/trace_event.h"
+#include "base/values.h"
 #include "build/android_buildflags.h"
 #include "build/branding_buildflags.h"
 #include "build/build_config.h"
@@ -116,6 +117,7 @@
 #include "components/collaboration/public/pref_names.h"
 #include "components/commerce/core/prefs.h"
 #include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/browser/cookie_settings.h"
 #include "components/content_settings/core/common/pref_names.h"
 #include "components/contextual_search/contextual_search_service.h"
 #include "components/contextual_tasks/public/prefs.h"
@@ -1871,6 +1873,14 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry,
   chrome_labs_prefs::RegisterProfilePrefs(registry);
   ChromeLocationBarModelDelegate::RegisterProfilePrefs(registry);
   content_settings::CookieSettings::RegisterProfilePrefs(registry);
+#if BUILDFLAG(IS_ANDROID)
+  // Jagad: block third-party cookies by default (users can still allow them
+  // per site or globally in Settings > Site settings > Third-party cookies).
+  registry->SetDefaultPrefValue(
+      prefs::kCookieControlsMode,
+      base::Value(static_cast<int>(
+          content_settings::CookieControlsMode::kBlockThirdParty)));
+#endif  // BUILDFLAG(IS_ANDROID)
   ChromeVersionService::RegisterProfilePrefs(registry);
   chrome_browser_net::NetErrorTabHelper::RegisterProfilePrefs(registry);
   chrome_prefs::RegisterProfilePrefs(registry);
